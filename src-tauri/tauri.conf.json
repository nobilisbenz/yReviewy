{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yReviewy",
  "version": "0.1.1",
  "identifier": "dev.yalive.yreviewy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "yReviewy", "width": 420, "height": 840, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
